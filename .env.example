# Job Hunter - backend environment template (variable names only)
# Copy to .env and fill in real values. Never commit the real .env.

# App
APP_ENV=development
API_BASE_URL=http://localhost:8000

# Database (PostgreSQL on Neon)
# Canonical key is DATABASE_URL; the existing local .env uses legacy alias DatabaseURL, which the backend also accepts.
DATABASE_URL=

# Auth
# Recommend a secret of at least 32 bytes/characters.
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# CORS - comma-separated list of allowed origins (or JSON array)
CORS_ORIGINS=http://localhost:5173,chrome-extension://<extension-id>

# AI (Phase 8) - backend only
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Resume storage (MVP: local filesystem)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Observability
SENTRY_DSN=